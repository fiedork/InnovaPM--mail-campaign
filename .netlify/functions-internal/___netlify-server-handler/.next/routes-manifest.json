{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/campaigns/[id]",
      "regex": "^/api/campaigns/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/campaigns/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/campaigns/[id]/companies/[companyId]",
      "regex": "^/api/campaigns/([^/]+?)/companies/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPcompanyId": "nxtPcompanyId"
      },
      "namedRegex": "^/api/campaigns/(?<nxtPid>[^/]+?)/companies/(?<nxtPcompanyId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/campaigns/[id]/recipients/[companyId]",
      "regex": "^/api/campaigns/([^/]+?)/recipients/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPcompanyId": "nxtPcompanyId"
      },
      "namedRegex": "^/api/campaigns/(?<nxtPid>[^/]+?)/recipients/(?<nxtPcompanyId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/campaigns/[id]/[action]",
      "regex": "^/api/campaigns/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPaction": "nxtPaction"
      },
      "namedRegex": "^/api/campaigns/(?<nxtPid>[^/]+?)/(?<nxtPaction>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/contacts/[id]",
      "regex": "^/api/contacts/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/contacts/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/contacts/[id]/campaigns",
      "regex": "^/api/contacts/([^/]+?)/campaigns(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/contacts/(?<nxtPid>[^/]+?)/campaigns(?:/)?$"
    },
    {
      "page": "/api/messages/[id]",
      "regex": "^/api/messages/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/messages/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/recipients/[companyId]/select",
      "regex": "^/api/recipients/([^/]+?)/select(?:/)?$",
      "routeKeys": {
        "nxtPcompanyId": "nxtPcompanyId"
      },
      "namedRegex": "^/api/recipients/(?<nxtPcompanyId>[^/]+?)/select(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/auth/login",
      "regex": "^/api/auth/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/login(?:/)?$"
    },
    {
      "page": "/api/auth/logout",
      "regex": "^/api/auth/logout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/logout(?:/)?$"
    },
    {
      "page": "/api/campaigns",
      "regex": "^/api/campaigns(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/campaigns(?:/)?$"
    },
    {
      "page": "/api/contacts",
      "regex": "^/api/contacts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/contacts(?:/)?$"
    },
    {
      "page": "/api/events",
      "regex": "^/api/events(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/events(?:/)?$"
    },
    {
      "page": "/api/health",
      "regex": "^/api/health(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/health(?:/)?$"
    },
    {
      "page": "/api/import/campaign",
      "regex": "^/api/import/campaign(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/import/campaign(?:/)?$"
    },
    {
      "page": "/api/import/contacts",
      "regex": "^/api/import/contacts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/import/contacts(?:/)?$"
    },
    {
      "page": "/api/settings",
      "regex": "^/api/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/settings(?:/)?$"
    },
    {
      "page": "/api/status",
      "regex": "^/api/status(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/status(?:/)?$"
    },
    {
      "page": "/api/track/open",
      "regex": "^/api/track/open(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/track/open(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}